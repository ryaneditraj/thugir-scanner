# Supabase (service role - server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# QStash signature verification (from the Upstash console)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Web app callback after monitor-linked scans (delta email)
SITE_URL=https://your-scanner.vercel.app
WORKER_CALLBACK_SECRET=
# Dev only: accept unsigned jobs (NEVER set in production)
# ALLOW_UNSIGNED_JOBS=1

# Deep Scan — full TCSF aggressive pipeline (default ON)
DEEP_USE_MAX_POWER=1
DEEP_MAX_RUNTIME_S=420
DEEP_API_MAX_ENDPOINTS=400
DEEP_WEB_TIMEOUT_S=25
DEEP_RUN_EXTERNAL_TOOLS=1
DEEP_RUN_NUCLEI=1
TCSF_MAX_POWER=1
TCSF_POWER_MODE=aggressive

# Path to thugir-node (auto-detected from monorepo layout if unset)
# THUGIR_ENGINE_ROOT=/path/to/thugir-node

# Engine LLM (optional; engine degrades to heuristics without it)
OPENROUTER_API_KEY=
