# Hackathon dev env — private repo only. Copy to web/.env.local before npm run dev:
#   cp web/config/hackathon.env web/.env.local
#
# NEVER commit this file to a public repo or share the key outside your team.

DEV_MODE=1
DEV_TIER=deep
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hack Club AI proxy (OpenAI-compatible chat completions)
HACK_CLUB_AI_API_KEY=REDACTED
HACK_CLUB_AI_MODEL=qwen/qwen3-32b
HACK_CLUB_AI_BASE_URL=https://ai.hackclub.com/proxy/v1

# Agent engine (optional — uses same Hack Club key)
THUGIR_AGENT_LLM_API_KEY=REDACTED
THUGIR_AGENT_LLM_BASE_URL=https://ai.hackclub.com/proxy/v1
THUGIR_AGENT_LLM_MODEL=qwen/qwen3-32b
THUGIR_AGENT_LLM_PROVIDER=openai
