# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the client. Used by route handlers + admin actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Upstash (rate limiting + QStash job queue) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ---- Deep Scan worker ----
# Public URL of the Python worker that QStash will POST jobs to.
WORKER_URL=https://thugir-worker.onrender.com/run

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Amount in paise for one Deep Scan credit (default 49900 = ₹499).
DEEP_SCAN_AMOUNT_INR=49900
# Recurring plan id from Razorpay dashboard (Continuous Protection).
RAZORPAY_CONTINUOUS_PLAN_ID=

# ---- Local demo (no Supabase / Razorpay required) ----
# Quick start: cp web/config/hackathon.env web/.env.local
# DEV_MODE=1
# DEV_TIER=deep

# ---- AI analyst ----
# Hack Club AI (default for hackathon — change model in /admin/settings)
HACK_CLUB_AI_API_KEY=REDACTED
HACK_CLUB_AI_MODEL=qwen/qwen3-32b
# OpenAI-compatible base (web app appends /chat/completions when calling)
HACK_CLUB_AI_BASE_URL=https://ai.hackclub.com/proxy/v1

# OpenRouter fallback (optional)
OPENROUTER_API_KEY=

# ---- Thugir Agent Engine (optional — deep scans on worker/local) ----
# THUGIR_AGENT_SCAN_ENABLED=1
# THUGIR_AGENT_SCAN_MODE=quick
# THUGIR_AGENT_PYTHON=python3
# THUGIR_AGENT_LLM_API_KEY=REDACTED
# THUGIR_AGENT_LLM_BASE_URL=https://ai.hackclub.com/proxy/v1
# THUGIR_AGENT_LLM_MODEL=qwen/qwen3-32b
# THUGIR_AGENT_LLM_PROVIDER=openai

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Secret shared with the worker so it can write findings back via the internal callback.
WORKER_CALLBACK_SECRET=

# ---- Cron + email (Continuous Protection) ----
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> to /api/cron/monitors
CRON_SECRET=
# Optional: Resend for monitor delta emails
RESEND_API_KEY=
RESEND_FROM=Thugir Scanner <alerts@thugirlabs.com>
