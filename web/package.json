{
  "name": "thugir-scanner-web",
  "version": "0.1.0",
  "private": true,
  "description": "Thugir Scanner for AI-built apps - Next.js web app (Vercel). Free-tier checks run here; Deep Scan is delegated to the Python worker.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:framework": "node scripts/test-framework.mjs",
    "test:smoke": "node scripts/smoke-scan.mjs",
    "power-scan": "tsx scripts/power-scan.ts",
    "ship-gate": "node scripts/ship-gate.mjs",
    "pr-integrity": "node scripts/manage-pr-integrity.mjs --audit",
    "close-orphan-prs": "node scripts/close-orphan-prs.mjs --dry-run",
    "patterns": "node scripts/pattern-catalog.mjs && node scripts/export-patterns-seed.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@upstash/qstash": "^2.7.17",
    "@upstash/ratelimit": "^2.0.3",
    "@upstash/redis": "^1.34.3",
    "next": "^14.2.35",
    "razorpay": "^2.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "puppeteer-core": "^23.11.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
